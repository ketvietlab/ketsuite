{
  "name": "@ketvietlab/ketsuite",
  "version": "0.1.43",
  "description": "KetSuite — business modules built on Ket, using only the contract a third-party module has.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ketsuite": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketvietlab/ketsuite.git",
    "directory": "packages/ketsuite"
  },
  "homepage": "https://github.com/ketvietlab/ketsuite#readme",
  "bugs": {
    "url": "https://github.com/ketvietlab/ketsuite/issues"
  },
  "keywords": [
    "erp",
    "business",
    "modules",
    "ketjs",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepack": "npm run build --prefix ../.."
  },
  "exports": {
    "./flow/server": {
      "types": "./dist/modules/flow/server.d.ts",
      "default": "./dist/modules/flow/server.js"
    },
    "./shipping": {
      "types": "./dist/shipping.d.ts",
      "default": "./dist/shipping.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./deployment": {
      "types": "./dist/deployment.d.ts",
      "default": "./dist/deployment.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/application-switcher": {
      "types": "./dist/ui/application-switcher.d.ts",
      "default": "./dist/ui/application-switcher.js"
    },
    "./backend": {
      "types": "./dist/modules/backend/index.d.ts",
      "default": "./dist/modules/backend/index.js"
    },
    "./user-backend": {
      "types": "./dist/modules/user_backend/index.d.ts",
      "default": "./dist/modules/user_backend/index.js"
    },
    "./livedoc": {
      "types": "./dist/ui/client/live-doc-view.d.ts",
      "default": "./dist/ui/client/live-doc-view.js"
    },
    "./livedoc/render": {
      "types": "./dist/ui/client/live-doc-shell.d.ts",
      "default": "./dist/ui/client/live-doc-shell.js"
    },
    "./user-modal-client": {
      "types": "./dist/ui/client/user-modal-client.d.ts",
      "default": "./dist/ui/client/user-modal-client.js"
    },
    "./ui/icons": {
      "types": "./dist/ui/icons.d.ts",
      "default": "./dist/ui/icons.js"
    },
    "./record-modal-client": {
      "types": "./dist/ui/client/record-modal.d.ts",
      "default": "./dist/ui/client/record-modal.js"
    }
  },
  "dependencies": {
    "@ketvietlab/flow-client": "0.1.43",
    "@ketvietlab/flow-ui": "0.1.43",
    "@ketvietlab/design-system": "0.1.43",
    "@ketvietlab/ketjs": "0.6.1",
    "@ketvietlab/ketjs-view": "0.6.1",
    "@ketvietlab/website-client": "0.1.43",
    "chart.js": "4.5.1",
    "ioredis": "^6.0.0",
    "marked": "18.1.0",
    "sharp": "0.35.5",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ]
}
