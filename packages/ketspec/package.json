{
  "name": "@ketvietlab/ketspec",
  "version": "0.1.41",
  "description": "Spec: an API reference and try-it console for OpenAPI 3 documents, built on the Két design system.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketvietlab/ketsuite.git",
    "directory": "packages/ketspec"
  },
  "homepage": "https://github.com/ketvietlab/ketsuite#readme",
  "bugs": {
    "url": "https://github.com/ketvietlab/ketsuite/issues"
  },
  "keywords": [
    "openapi",
    "api-reference",
    "design-system",
    "ketjs"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepack": "npm run build --prefix ../.."
  },
  "bin": {
    "ketspec": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": "./dist/browser/ketspec.mjs",
    "./styles.css": "./dist/styles.css",
    "./assets/logo-light.svg": "./dist/assets/logo-light.svg",
    "./assets/logo-dark.svg": "./dist/assets/logo-dark.svg",
    "./assets/mark.svg": "./dist/assets/mark.svg"
  },
  "dependencies": {
    "@ketvietlab/design-system": "0.1.41",
    "@ketvietlab/ketjs-view": "0.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ]
}
