#!/usr/bin/env bash
# Installed by `npm install`'s `prepare` script (`git config core.hooksPath
# .githooks`), so this runs for every contributor without anyone remembering
# to opt in. The checks, and which changes trigger each one, live in
# tools/precommit.mjs; the Két Việt hook that commits this source calls the same
# file, so a tree accepted there is accepted here. Anything that needs a build,
# a database or the test suite stays with CI and the release gates.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec node tools/precommit.mjs --staged
