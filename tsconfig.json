{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "packages/*/src/**/*",
    "packages/website-client/client/**/*",
    "packages/website-client/server/**/*",
    "apps/**/*",
    "ket.workspace.ts",
    "examples/**/*",
    "test/**/*",
    "tools/**/*",
    "bench/**/*"
  ],
  // The bundled Mermaid for screen help is generated, minified output (tools/build-backend-mermaid.mjs).
  "exclude": ["node_modules", "packages/ketsuite/src/modules/backend/design/client/mermaid"]
}
