{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!packages/ketsuite/src/modules/address/data",
      "!packages/flow-client/client/*.generated.mjs"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "jsxRuntime": "transparent",
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 110
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useSemanticElements": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "useLiteralKeys": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noThenProperty": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/ketsuite/src/**/*.ts",
        "packages/ketsuite/src/**/*.tsx",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "!**/*.test.ts",
        "!packages/ketsuite/src/modules/backend/screen.ts"
      ],
      "plugins": ["./lint/rules/no-shell-internals.grit", "./lint/rules/admin-route-uses-shell.grit"]
    },
    {
      "includes": [
        "packages/ketsuite/src/**/*.ts",
        "packages/ketsuite/src/**/*.tsx",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "!**/*.test.ts",
        "!packages/ketsuite/src/ui/**"
      ],
      "plugins": ["./lint/rules/no-raw-jsx-tag.grit", "./lint/rules/no-markup-in-html.grit"]
    },
    {
      "includes": ["packages/ketsuite/src/**/*.tsx", "apps/**/*.tsx", "!packages/ketsuite/src/ui/**"],
      "plugins": ["./lint/rules/kit-component-as-jsx.grit"]
    }
  ]
}
